# Sao chép file này thành .env và điền giá trị thật (KHÔNG commit .env)

# ID của Google Sheet (lấy từ URL: .../spreadsheets/d/<SHEET_ID>/edit)
SHEET_ID=

# Telegram bot token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Chat id nơi nhận tin (chat riêng của người nhận với bot).
# Gửi cho NHIỀU người: ngăn cách bằng dấu phẩy, vd: 111111,222222
TELEGRAM_CHAT_ID=

# Nội dung file service account JSON (dán nguyên cả JSON 1 dòng).
# Khi chạy local có thể trỏ tới file thay vì dán: dùng GOOGLE_CREDENTIALS_FILE
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=

# Đặt 1 để in ra thay vì gửi Telegram / ghi sent_log (dùng khi test)
DRY_RUN=0

# ── Phase 2: Gemini sinh lời chúc ──────────────────────────────────────────
# API key lấy ở Google AI Studio (https://aistudio.google.com/apikey), dạng AIza...
GEMINI_API_KEY=
# (tuỳ chọn) đổi model; để trống dùng mặc định gemini-3.1-flash-lite
GEMINI_MODEL=
# 1 = dùng Gemini (mặc định); 0 = dùng template cố định Phase 1.
# Khi thiếu key hoặc Gemini lỗi, hệ thống tự rơi về template dù USE_AI=1.
USE_AI=1
